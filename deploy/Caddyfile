{
	email {$ACME_EMAIL}
	# Let's Encrypt production by default; set ACME_CA to the staging directory for first tries.
	# Note: an explicit acme_ca drops Caddy's default ZeroSSL fallback issuer.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Never log secrets that travel in URLs: WebSocket ?token=... and the Telegram webhook path.
	log default {
		format filter {
			wrap json
			request>uri regexp "(token=)[^&]*|(/telegram/webhook/)[^/?]*" "${1}${2}REDACTED"
		}
	}
}

{$DOMAIN} {
	# No explicit `tls` line: for DOMAIN=localhost (local smoke tests) Caddy automatically uses its
	# internal CA (`tls internal`) and never contacts Let's Encrypt; real domains get ACME certs.

	request_body {
		max_size 9MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The api trusts X-Forwarded-For from any peer, so Caddy must never pass a client-supplied
	# value on: always replace it with the address Caddy actually saw.
	# /metrics has no authentication and shows activity counters: never expose it publicly.
	# (Read it from inside the network; see deploy/README.md.)
	@metrics path /metrics /metrics/*
	handle @metrics {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
