# Production settings. Copy with `python scripts/gen_secrets.py` (fills the secrets, mode 0600).
# deploy/.env.prod is git-ignored; never commit it or paste its values anywhere.
#
# Every production compose command needs `--env-file deploy/.env.prod`.
# Never run `docker compose config` without `-q` where output is logged: it prints secrets.

# Public hostname Caddy serves (and gets a Let's Encrypt certificate for). Use `localhost` for
# a local smoke test (Caddy then uses its internal CA).
DOMAIN=home.example.duckdns.org
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Optional: PUBLIC_BASE_URL defaults to https://$DOMAIN in docker-compose.prod.yml.
# PUBLIC_BASE_URL=https://home.example.duckdns.org
# Use Let's Encrypt staging for the first tries to avoid its rate limits, then remove this line
# and restart Caddy (staging certificates are not trusted by browsers).
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Generated by scripts/gen_secrets.py (the lines below are replaced; do not edit by hand).
POSTGRES_PASSWORD=
# 48 bytes urlsafe.
JWT_SECRET=
# Fernet key for encrypted snapshots. Losing it makes stored snapshots unreadable: back it up.
SNAPSHOT_KEY=

# Email: console (log only) or smtp.
EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587  (leave unset for the default 587; never set it empty)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Telegram alerts (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

NTFY_BASE_URL=https://ntfy.sh

# DuckDNS (optional): only used by the `duckdns` compose profile, which keeps the DNS record
# of a free *.duckdns.org name pointed at this VM. Enable it by uncommenting COMPOSE_PROFILES
# (deploy.sh passes this file with --env-file, and compose reads COMPOSE_PROFILES from it).
# The token is on your DuckDNS account page; it is a secret (never commit or paste it).
DUCKDNS_TOKEN=
# COMPOSE_PROFILES=duckdns
# The subdomain defaults to DOMAIN without ".duckdns.org"; set this only to override it.
# DUCKDNS_SUBDOMAIN=
